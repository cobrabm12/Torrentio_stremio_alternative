{
  "name": "stremio-torrent-addon",
  "version": "0.1.0",
  "description": "Modern, fast and optimized Torrentio-style Stremio addon with advanced quality/audio filtering and debrid support",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "stremio",
    "addon",
    "torrent",
    "torrentio",
    "debrid"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "fastify": "^5.2.0",
    "got": "^14.4.5",
    "lru-cache": "^11.0.2",
    "parse-torrent": "^11.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
